# ClinCode environment configuration (EXAMPLE)
#
# Copy this file to `.env` and adjust values for your environment.
#   - `.env` is git-ignored and must NEVER be committed.
# All values below are safe, non-secret PLACEHOLDERS or local-development
# defaults. Do NOT put real credentials, API keys, or PHI in this file.

# ── Application ───────────────────────────────────────────────────────────
APP_NAME=clincode
APP_ENV=local                 # local | dev | prod
LOG_LEVEL=INFO                # DEBUG | INFO | WARNING | ERROR
# Generate a real per-environment secret; the value below is only a placeholder.
APP_SECRET_KEY=change-me-in-your-local-env

# ── PostgreSQL (relational store) ─────────────────────────────────────────
# Local-development defaults; override for any shared/real environment.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=clincode
POSTGRES_USER=clincode
POSTGRES_PASSWORD=change-me-local-dev
# Full SQLAlchemy-style URL (derived from the values above); shown for convenience.
# DATABASE_URL=postgresql+psycopg://clincode:change-me-local-dev@localhost:5432/clincode

# ── Qdrant (vector search) ────────────────────────────────────────────────
QDRANT_HOST=localhost
QDRANT_PORT=6333
# Leave empty for local dev; set per environment if the server requires it.
QDRANT_API_KEY=

# ── MinIO (S3-compatible object storage) ──────────────────────────────────
# Local-development defaults; override for any shared/real environment.
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=change-me-local-dev
MINIO_BUCKET=clincode-artifacts
MINIO_SECURE=false            # true when serving over TLS

# ── Redis (queue / cache) ─────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
# Leave empty for local dev; set per environment if the server requires it.
REDIS_PASSWORD=

# ── MLflow (experiment & model tracking) ──────────────────────────────────
MLFLOW_TRACKING_URI=http://localhost:5000

# ── Terminology & coding configuration ────────────────────────────────────
# Fixed CMS ICD-10-CM release used as the source of truth. Placeholder value;
# the exact release is finalized in the M1 terminology-preparation task and is
# also recorded in database metadata.
ICD10CM_RELEASE_VERSION=2026
# Fixed edition of the ICD-10-CM Official Guidelines for Coding and Reporting.
CODING_GUIDELINES_EDITION=FY2026
# Minimum calibrated confidence for a suggestion to enter the auto-accept band.
CONFIDENCE_THRESHOLD=0.80
# Maximum number of candidate codes surfaced per clinical entity.
MAX_SUGGESTIONS=5

# ── LLM provider (OPTIONAL) ───────────────────────────────────────────────
# The deterministic/ML pipeline works without an LLM. The LLM NEVER generates
# final ICD-10-CM codes; it only explains/summarizes grounded, retrieved data.
LLM_PROVIDER=none             # none | openai | anthropic | ollama | ...
# NEVER commit a real key. Leave empty here; set it only in your local `.env`.
LLM_API_KEY=
LLM_MODEL=
# Base URL for self-hosted or alternative providers (e.g. http://localhost:11434).
LLM_BASE_URL=
