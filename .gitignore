# ==========================================================================
# ClinCode .gitignore
# Goal: never commit secrets, PHI, or large generated artifacts.
# ==========================================================================

# ── Environment & secrets ─────────────────────────────────────────────────
.env
.env.*
!.env.example
*.pem
*.key
secrets/
.secrets/

# ── Python ────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.egg
*.egg-info/
.eggs/
build/
dist/
*.manifest
*.spec
.pytest_cache/
.mypy_cache/
.ruff_cache/
.pytype/
.coverage
.coverage.*
htmlcov/
coverage.xml
.tox/
.nox/
.hypothesis/

# ── Virtual environments ──────────────────────────────────────────────────
.venv/
venv/
env/
ENV/
.python-version

# ── IDE / editor ──────────────────────────────────────────────────────────
.idea/
.vscode/
*.code-workspace
*.swp
*.swo
*~

# ── OS files ──────────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# ── Logs ──────────────────────────────────────────────────────────────────
*.log
logs/

# ── Local databases ───────────────────────────────────────────────────────
*.db
*.sqlite
*.sqlite3

# ── Model weights & ML artifacts (never commit large binaries) ─────────────
*.pt
*.pth
*.onnx
*.bin
*.safetensors
*.h5
*.ckpt
*.pkl
*.joblib
models/
checkpoints/

# ── Generated embeddings & vector indexes ─────────────────────────────────
*.npy
*.npz
*.faiss
*.index
embeddings/
vector_store/

# ── Qdrant local storage ──────────────────────────────────────────────────
qdrant_storage/
qdrant_data/

# ── MinIO / object storage (local data) ───────────────────────────────────
minio_data/
.minio/

# ── MLflow local artifacts ────────────────────────────────────────────────
mlruns/
mlartifacts/

# ── Data: never commit datasets, PHI, or generated artifacts ──────────────
# Ignore all data contents; keep only .gitkeep directory placeholders.
data/raw/*
data/interim/*
data/processed/*
data/raw/notes/*
data/raw/terminology/*
!data/raw/notes/
!data/raw/terminology/
!data/raw/notes/.gitkeep
!data/raw/terminology/.gitkeep
!data/interim/.gitkeep
!data/processed/.gitkeep

# ── PHI-like files (never commit anything that could contain patient data) ─
*.phi
*_phi.*
phi_*.*

# ── Docker / local infrastructure artifacts ───────────────────────────────
*.pid
docker-compose.override.yml
.docker/
volumes/

# ── Temporary / scratch files ─────────────────────────────────────────────
tmp/
temp/
*.tmp
*.bak
*.orig
scratch/
